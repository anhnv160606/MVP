APP_ENV=dev
SUPABASE_URL=https://your-project.supabase.co
# Backend only: sb_secret_... or legacy service_role JWT, not sb_publishable_/anon.
SUPABASE_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional IfcMCP extra must be installed first.
ENABLE_IFCMCP=false
STATE_DB=data/runtime.sqlite3
WORKSPACE_DIR=data/projects
PLAYBOOK_PATH=
MAX_AGENT_ROUNDS=24
# Required with APP_ENV=prod. This is a single-workspace server credential.
API_TOKEN=
